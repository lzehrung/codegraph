{
  "name": "@lzehrung/codegraph-native",
  "version": "1.8.34",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./js-fallback": {
      "types": "./js-fallback.d.ts",
      "import": "./js-fallback.js",
      "default": "./js-fallback.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "js-fallback.js",
    "js-fallback.d.ts"
  ],
  "scripts": {
    "build": "node ../../node_modules/@napi-rs/cli/dist/cli.js build --platform --release --cwd . --no-js --dts index.d.ts",
    "build:debug": "node ../../node_modules/@napi-rs/cli/dist/cli.js build --platform --cwd . --no-js --dts index.d.ts",
    "clean": "cargo clean",
    "create-npm-dirs": "node ../../node_modules/@napi-rs/cli/dist/cli.js create-npm-dirs --cwd .",
    "artifacts": "node ../../node_modules/@napi-rs/cli/dist/cli.js artifacts --cwd .",
    "prepublish:napi": "node ../../node_modules/@napi-rs/cli/dist/cli.js pre-publish --cwd ."
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "tree-sitter": "^0.25.0",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scss": "^1.0.0",
    "tree-sitter-svelte": "^0.11.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-vue": "^0.2.1"
  },
  "napi": {
    "binaryName": "index",
    "packageName": "@lzehrung/codegraph-native",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  }
}
