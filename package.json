{
  "name": "codegraph",
  "version": "1.3.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "codegraph": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "if exist dist rmdir /s /q dist",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "preversion": "npm run test:ci && npm run build",
    "postversion": "git push && git push --tags",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzehrung/codegraph.git"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dependency graph",
    "symbol index",
    "go to definition",
    "find references",
    "AST grep",
    "monorepo",
    "npm",
    "yarn",
    "pnpm",
    "lerna",
    "python"
  ],
  "author": "Luke Zehrung",
  "license": "ISC",
  "description": "A tiny tool to understand a repo, navigate code, and answer questions fast. Builds dependency graphs and symbol indexes for JS/TS/Python monorepos.",
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@vitest/ui": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "js-yaml": "4.1.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsconfig-paths": "^4.2.0"
  },
  "overrides": {
    "tree-sitter": "^0.25.0"
  }
}
