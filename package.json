{
  "name": "@lzehrung/codegraph",
  "version": "1.8.13",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "codegraph": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "if exist dist rmdir /s /q dist",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write ./src",
    "lint": "npx eslint ./src --fix",
    "prepare": "npm run build",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "preversion": "npm run test:ci && npm run build",
    "postversion": "git push && git push --tags",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "publish:patch": "npm run build && npm version patch && npm publish && git push && git push --tags",
    "publish:minor": "npm run build && npm version minor && npm publish && git push && git push --tags",
    "publish:major": "npm run build && npm version major && npm publish && git push && git push --tags",
    "graph:default": "npx codegraph graph ./src",
    "graph:json": "npx codegraph graph ./src --json --symbols-detailed --compact-json > codegraph.json",
    "graph:mermaid": "npx codegraph graph ./src --mermaid --symbols-detailed > graph.mermaid.mmd",
    "graph:dot": "npx codegraph graph ./src --dot --symbols-detailed > graph.dot"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzehrung/codegraph.git"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "dependency graph",
    "symbol index",
    "go to definition",
    "find references",
    "AST grep",
    "monorepo",
    "npm",
    "yarn",
    "pnpm",
    "lerna",
    "python"
  ],
  "author": "Luke Zehrung",
  "license": "ISC",
  "description": "A tiny tool to understand a repo, navigate code, and answer questions fast. Builds dependency graphs and symbol indexes for JS/TS/Python monorepos.",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "@types/picomatch": "^4.0.2",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.7.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "fast-glob": "^3.3.3",
    "picomatch": "^4.0.3",
    "tree-sitter": "^0.25.0",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scss": "^1.0.0",
    "tree-sitter-svelte": "^0.11.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-vue": "^0.2.1",
    "tsconfig-paths": "^4.2.0"
  },
  "overrides": {
    "tree-sitter": "^0.25.0"
  }
}
